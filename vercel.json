{
  "buildCommand": "echo 'Static build'",
  "outputDirectory": ".",
  "devCommand": "echo 'Dev mode'",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1.js"
    }
  ]
}
